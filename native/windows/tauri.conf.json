{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uniteam",
  "version": "1.1.0",
  "identifier": "com.uniteam.desktop",
  "build": {
    "frontendDist": "loader"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "RTM Team",
    "shortDescription": "Uniteam — الحضور والانصراف",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Arabic",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVFRjhEMTM3RENERDAxRkIKUldUN0FkM2NOOUg0WGl1aG45N2owemwzSU9lTG03czdGalg2cWF4YmxoRnlYQ2hJSHJVN1VubksK",
      "endpoints": [
        "https://github.com/rtmteam/Uniteam-v6/releases/download/windows-updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
