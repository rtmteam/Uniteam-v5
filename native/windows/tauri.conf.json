{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Uniteam",
  "version": "1.0.0",
  "identifier": "com.uniteam.desktop",
  "build": {
    "frontendDist": "loader"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "RTM Team",
    "shortDescription": "Uniteam — الحضور والانصراف",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Arabic", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
